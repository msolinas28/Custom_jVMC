+def _weak(value):
+    """
+    Weak reference to a static keyword argument, so that the cache of a decorated method does
+    not keep it alive, or the value itself if it has no weak references (numbers, strings, ...).
+    """
+    try:
+        return weakref.WeakMethod(value) if inspect.ismethod(value) else weakref.ref(value)
+    except TypeError:
+        return value
+
+def _drop_cache_entry(instance_ref, cache_key):
+    """Remove an entry of the cache of a decorated method, if the instance still exists."""
+    instance = instance_ref()
+    if instance is not None:
+        instance._sharded_cache.pop(cache_key, None)
+
