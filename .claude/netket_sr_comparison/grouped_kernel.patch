+    def _call_grouped(self, layout: BatchLayout, kwargs, args, jsh_fn):
+        """
+        As `_call_local`, but every dispatch evaluates a group of up to ``MAX_BATCHES_PER_CALL``
+        consecutive batches of ``layout``, in a loop inside the compiled function (see
+        `_loop_over_batches`). Every dispatch costs a fixed host time, which on a GPU can be
+        longer than the evaluation of a batch. The compiled function always gets a full group
+        of rows, the last group being zero padded, so it is compiled once whatever the number
+        of samples, and the padding batches are not evaluated.
