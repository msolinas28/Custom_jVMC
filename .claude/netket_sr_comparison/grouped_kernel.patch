+# A batched call of a method decorated with ``group_batches=True`` evaluates up to
+# MAX_BATCHES_PER_CALL batches per dispatch, with at most GROUP_BYTES of arguments per device
+MAX_BATCHES_PER_CALL = 64
+GROUP_BYTES = 2**28
+_N_BATCHES = "_n_batches"
+
+def _loop_over_batches(fn, b):
+    """
+    ``fn`` (vmapped over the first axis of every positional argument after the first one)
+    evaluated on blocks of ``b`` rows, in a loop inside the compiled function, over the first
+    ``kw["_n_batches"]`` blocks of the arguments only: the remaining rows are padding and their
+    results are zero. The number of blocks is an argument of the compiled function, so it is
+    compiled once for a given number of rows of the arguments, whatever the number of samples.
+    """
+    def looped_fn(kw, *args):
+        kw = dict(kw)
+        n_batches = kw.pop(_N_BATCHES)
+
+        def batch(i):
+            return fn(kw, *(jax.lax.dynamic_slice_in_dim(a, i * b, b) for a in args))
+
+        def write(out, piece, i):
+            return jax.tree_util.tree_map(
+                lambda o, p: jax.lax.dynamic_update_slice_in_dim(o, p, i * b, axis=0), out, piece
+            )
+
+        # The output is allocated from the first batch. Zeros are the same on every device,
+        # while the loop carry has to vary across devices like the batch results
+        first = batch(0)
+        out = jax.tree_util.tree_map(
+            lambda p: jax.lax.pcast(
+                jnp.zeros((args[0].shape[0],) + p.shape[1:], p.dtype), MESH.axis_names, to="varying"
+            ),
+            first
+        )
+
+        return jax.lax.fori_loop(1, n_batches, lambda i, out: write(out, batch(i), i), write(out, first, 0))
+
+    return looped_fn
+
