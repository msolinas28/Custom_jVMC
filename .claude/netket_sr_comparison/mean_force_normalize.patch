+# Largest block of rows that a sum over the samples gives to XLA at once. When it compiles a
+# matrix product or a reduction, XLA autotunes it on scratch copies of its operands: with the
+# whole (n_samples, n_params) Jacobian as operand, these copies are as large as the Jacobian.
+ROW_BLOCK_BYTES = 2**30
+
+def _sum_over_rows(f, xs, n_groups=1):
+    """
+    ``f(*xs)`` for an ``f`` that sums over the first axis of every array of ``xs``, computed as
+    the sum of ``f`` over blocks of at most ``ROW_BLOCK_BYTES`` of the arrays' rows, in a loop
+    inside the compiled function. The rows are split into ``n_groups`` equal groups that are
+    sliced separately, so that every device slices its own rows when the arrays are sharded
+    across ``n_groups`` devices.
+    """
+    n = xs[0].shape[0] // n_groups
+    row_bytes = max(math.prod(x.shape[1:]) * x.dtype.itemsize for x in xs)
+    block = max(1, min(n, ROW_BLOCK_BYTES // row_bytes))
+    xs = [x.reshape((n_groups, n) + x.shape[1:]) for x in xs]
+
+    def f_block(start, size):
+        return f(*(
+            jax.lax.dynamic_slice_in_dim(x, start, size, axis=1).reshape((n_groups * size,) + x.shape[2:])
+            for x in xs
+        ))
+
+    n_full = n // block
+    out = jax.lax.fori_loop(1, n_full, lambda k, out: out + f_block(k * block, block), f_block(0, block))
+    if n % block:
+        out += f_block(n_full * block, n % block)
+
+    return out
+
